# REDMINE_HEADERS=X-Custom: value
# REDMINE_CA_BUNDLE=/path/to/ca.crt
# REDMINE_DANGEROUSLY_ACCEPT_INVALID_CERTS=0
# ALLOWED_PROJECT_IDS=
# DEFAULT_PAGE_SIZE=20
# TIMELINE_DEFAULT_LIMIT=30
